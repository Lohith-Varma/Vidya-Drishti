generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id                 Int      @id @default(autoincrement())
  fullName           String
  email              String   @unique
  leetcodeUsername   String?
  hackerrankUsername String?
  createdAt          DateTime @default(now())
}
