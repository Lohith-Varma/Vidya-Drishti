generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  password         String
  name             String
  role             Role     @default(STUDENT)

  rollNumber       String?  @unique
  department       String?
  year             String?
  phone            String?
  bio              String?
  avatar           String?
  employeeId       String?  @unique
  isActive         Boolean  @default(true)

  leetcodeHandle   String?
  hackerrankHandle String?
  githubHandle     String?
  codeforcesHandle String?
  linkedinUrl      String?
  resumeUrl        String?
  portfolioUrl     String?

  totalSolved      Int      @default(0)
  easySolved       Int      @default(0)
  mediumSolved     Int      @default(0)
  hardSolved       Int      @default(0)
  leetcodeRank     Int?
  contestRating    Float?
  streak           Int      @default(0)
  testsCompleted   Int      @default(0)
  avgScore         Float    @default(0)
  totalScore       Int      @default(0)
  rank             Int?

  // PLATFORM_ADMIN → collegeId is null
  // COLLEGE_ADMIN  → collegeId = their college
  // STUDENT        → collegeId = their college
  collegeId        String?
  college          College?     @relation(fields: [collegeId], references: [id])

  submissions      Submission[]
  createdTests     Assessment[] @relation("CreatedBy")
  onboardedBy      User?        @relation("OnboardedStudents", fields: [onboardedById], references: [id])
  onboardedById    String?
  onboardedStudents User[]      @relation("OnboardedStudents")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("users")
}

model College {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  address     String?
  city        String?
  state       String?
  website     String?
  logoUrl     String?
  isActive    Boolean  @default(true)

  users       User[]
  assessments Assessment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("colleges")
}

model Assessment {
  id            String     @id @default(cuid())
  title         String
  subject       String?
  description   String?
  duration      Int
  maxScore      Int        @default(0)
  startDate     DateTime
  endDate       DateTime
  language      String     @default("multiple")
  proctored     Boolean    @default(false)
  status        TestStatus @default(DRAFT)

  createdById   String
  createdBy     User       @relation("CreatedBy", fields: [createdById], references: [id])

  // Scoped to a college — null = platform-wide
  collegeId     String?
  college       College?   @relation(fields: [collegeId], references: [id])

  questions     Question[]
  submissions   Submission[]

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("assessments")
}

model Question {
  id           String     @id @default(cuid())
  title        String
  description  String
  difficulty   Difficulty @default(MEDIUM)
  marks        Int        @default(10)
  timeLimit    Int        @default(1000)
  memoryLimit  Int        @default(256)
  constraints  String?
  order        Int        @default(0)

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  testCases    TestCase[]
  submissions  Submission[] @relation("QuestionSubmissions")

  @@map("questions")
}

model TestCase {
  id         String   @id @default(cuid())
  input      String   @default("")
  output     String   @default("")
  hidden     Boolean  @default(false)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("test_cases")
}

model Submission {
  id            String             @id @default(cuid())
  code          String
  language      String
  verdict       Verdict            @default(PENDING)
  score         Int                @default(0)
  executionTime Float? 
  memoryUsed    Float?

  studentId    String
  student      User               @relation(fields: [studentId], references: [id])
  assessmentId String
  assessment   Assessment         @relation(fields: [assessmentId], references: [id])
  questionId   String?
  question     Question?          @relation("QuestionSubmissions", fields: [questionId], references: [id])
  results      SubmissionResult[]

  submittedAt  DateTime           @default(now())

  @@map("submissions")
}

model SubmissionResult {
  id           String     @id @default(cuid())
  passed       Boolean
  input        String?
  expected     String?
  actual       String?
  time         Float?
  hidden       Boolean    @default(false)

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("submission_results")
}

enum Role       { 
  PLATFORM_ADMIN 
  COLLEGE_ADMIN 
  STUDENT 
}

enum Difficulty { 
  EASY 
  MEDIUM 
  HARD 
}

enum TestStatus { 
  DRAFT 
  PUBLISHED 
  ENDED 
}

enum Verdict { 
  PENDING 
  AC 
  WA 
  TLE 
  MLE 
  RE 
  CE 
}
