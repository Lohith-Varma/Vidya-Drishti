generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // or "mysql" depending on your setup
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS (Standardized Values)
// ==========================================

enum Role {
  PLATFORM_ADMIN
  COLLEGE_ADMIN
  STUDENT
}

enum QuestionType {
  CODING
  MCQ
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EVALUATED
}

// ==========================================
// CORE TABLES (Multi-Tenancy & Users)
// ==========================================

model College {
  id          String   @id @default(uuid())
  name        String   @unique
  domain      String?  @unique // Useful for auto-assigning students via email
  location    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  users       User[]
  assessments Assessment[]

  @@index([name])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   // Store bcrypt/argon2 hashes, never plain text
  firstName    String
  lastName     String
  role         Role     @default(STUDENT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  collegeId    String?  // Nullable because Platform Admin doesn't need a college
  college      College? @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  
  externalStats ExternalStat?
  createdAssessments Assessment[] @relation("AssessmentCreator")
  attempts           Attempt[]

  @@index([email])
  @@index([collegeId])
}

// ==========================================
// EXTERNAL INTEGRATIONS (LeetCode/HackerRank)
// ==========================================

model ExternalStat {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  leetcodeUsername   String?
  leetcodeSolved     Int      @default(0)
  
  hackerrankUsername String?
  hackerrankScore    Float    @default(0)
  
  lastSyncedAt       DateTime @default(now())

  @@index([userId])
}

// ==========================================
// ASSESSMENT & QUESTIONS
// ==========================================

model Assessment {
  id              String           @id @default(uuid())
  title           String
  description     String?
  status          AssessmentStatus @default(DRAFT)
  startTime       DateTime?
  endTime         DateTime?
  durationMinutes Int              @default(120)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  collegeId       String   // Ensures exams are isolated to specific colleges
  college         College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  
  creatorId       String
  creator         User     @relation("AssessmentCreator", fields: [creatorId], references: [id])
  
  questions       Question[]
  attempts        Attempt[]

  @@index([collegeId])
  @@index([status])
}

model Question {
  id           String       @id @default(uuid())
  title        String
  problemText  String       @db.Text // Can store Markdown or HTML
  type         QuestionType @default(CODING)
  difficulty   Difficulty   @default(MEDIUM)
  marks        Float        @default(10.0)
  
  // For coding questions
  sampleInput  String?      @db.Text
  sampleOutput String?      @db.Text
  testCases    Json?        // Store an array of hidden test cases [{input: "", output: "", hidden: true}]

  // Relations
  assessmentId String
  assessment   Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  
  submissions  Submission[]

  @@index([assessmentId])
}

// ==========================================
// STUDENT SUBMISSIONS & RESULTS
// ==========================================

model Attempt {
  id           String        @id @default(uuid())
  status       AttemptStatus @default(IN_PROGRESS)
  startedAt    DateTime      @default(now())
  submittedAt  DateTime?
  totalScore   Float         @default(0)

  // Relations
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  assessmentId String
  assessment   Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  
  submissions  Submission[]

  @@unique([userId, assessmentId]) // A user can generally only attempt an assessment once
  @@index([userId])
  @@index([assessmentId])
}

model Submission {
  id            String   @id @default(uuid())
  code          String?  @db.Text // The actual code the student wrote
  language      String?  // e.g., "javascript", "python", "cpp"
  isCorrect     Boolean  @default(false)
  marksObtained Float    @default(0)
  executionTime Float?   // ms
  memoryUsed    Float?   // MB
  submittedAt   DateTime @default(now())

  // Relations
  attemptId     String
  attempt       Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  
  questionId    String
  question      Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId]) // One submission record per question per attempt
  @@index([attemptId])
}